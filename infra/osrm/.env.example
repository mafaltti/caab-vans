# OSRM port (default: 5000)
OSRM_PORT=5000

# Data source: Geofabrik Nordeste extract
# Download URL: https://download.geofabrik.de/south-america/brazil/nordeste-latest.osm.pbf
# Processing steps (run once, ~15-30 min):
#   docker run --rm -v ./data:/data osrm/osrm-backend osrm-extract -p /opt/car.lua /data/nordeste-latest.osm.pbf
#   docker run --rm -v ./data:/data osrm/osrm-backend osrm-partition /data/nordeste-latest.osrm
#   docker run --rm -v ./data:/data osrm/osrm-backend osrm-customize /data/nordeste-latest.osrm
