# Supabase Self-Host — Local Development
# Copy to .env and fill in values

# Postgres
POSTGRES_PASSWORD=your-super-secret-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5433

# JWT — must match across all services
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-at-least-32-chars
JWT_EXP=3600

# API Keys — generate with JWT_SECRET using supabase/postgres image init
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# External URLs
API_EXTERNAL_URL=http://localhost:54321
SITE_URL=http://localhost:3000

# Ports
KONG_HTTP_PORT=54321
STUDIO_PORT=54324
PGRST_PORT=3001
GOTRUE_PORT=9999

# Signup (disabled — users created via admin API)
DISABLE_SIGNUP=true
