# Supabase — public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — server only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database — server only (migrations, scripts)
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/postgres

# OSRM — road snapping (optional, omit to disable)
# Uncomment to enable. Sends van GPS data to the configured endpoint.
# Dev: https://router.project-osrm.org (public demo, 1 req/sec limit)
# Prod: http://localhost:5000 (self-hosted)
# OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_ROUTE_TIMEOUT_MS=300
# OSRM_MATCH_TIMEOUT_MS=200

# Map tiles (optional, falls back to OpenStreetMap)
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Debug logging (optional)
# DEBUG_ETA=1                  # Verbose ETA computation logs (~900-1,500 entries/hour)

# Scripts (optional)
# APP_URL=http://localhost:3000  # Used by simulate-tracking.ts only

# Progress pointer rollout (optional, default: legacy)
# legacy   — current time-based ETA selection (no behavior change)
# shadow   — compute both legacy and persisted, serve legacy, log mismatches
# persisted — use validated pointer for ETA targeting with legacy fallback
# TRACKING_PROGRESS_SOURCE=legacy
